###############################################################################
# CONFLUX UNIFIED PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
###############################################################################

# ─── APPLICATION CORE CONFIGURATION ──────────────────────────────────────────
APP_NAME=Conflux
ENVIRONMENT=production
WORKSPACE_FOLDER_NAME=Conflux
DEBUG=False

# ─── FRONTEND CONFIGURATION (React + Vite SPA) ────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── BACKEND SECURITY & CONFIGURATION (Django) ───────────────────────────────
# Run 'openssl rand -hex 32' to generate values
SECRET_KEY=generate_a_secure_random_production_secret_key_here
ENCRYPTION_KEY=generate_a_32_character_aes_encryption_key_here

# Hosts & CORS (comma separated values)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
SECURE_SSL_REDIRECT=True
FRONTEND_URL=http://localhost:3000

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# Connection string for external Neon/PostgreSQL instance
DATABASE_URL=postgresql://neondb_owner:password@ep-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── REDIS & CELERY TASK BROKER ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── GOOGLE OAUTH CLIENT CREDENTIALS (Google Cloud Console) ──────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ─── EMAIL SERVICE (SMTP Configurations) ──────────────────────────────────────
# SMTP is used only if EMAIL_HOST_USER is filled. Default falls back to console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=conflux.hq@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_email_password_here
DEFAULT_FROM_EMAIL=Conflux <noreply@conflux.app>
