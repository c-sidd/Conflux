# ==============================================================================
# Conflux Environment Configuration Template
# All secrets and credentials must be provided as placeholders only.
# Do NOT commit populated .env files into source control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Public URLs
PUBLIC_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:8000"]

# Database & Queue
DATABASE_URL=postgresql+asyncpg://conflux:conflux_dev_pass@localhost:5432/conflux_db
DATABASE_SYNC_URL=postgresql://conflux:conflux_dev_pass@localhost:5432/conflux_db
REDIS_URL=redis://localhost:6379/0

# Security & Session
# Generate strong secrets (e.g. openssl rand -hex 32)
SESSION_SECRET=placeholder_session_secret_at_least_32_characters_long
CSRF_SECRET=placeholder_csrf_secret_at_least_32_characters_long
# AES-256 key: 32 raw bytes URL-safe base64 encoded (Fernet compatible) or 64 hex chars
TOKEN_ENCRYPTION_KEY=placeholder_base64_32_byte_token_encryption_key_here
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google OAuth 2.0 Credentials
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=placeholder_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/accounts/google/callback
GOOGLE_SCOPES=["https://www.googleapis.com/auth/drive"]

# Mock Provider Mode (Only for local development and deterministic testing; NEVER in production)
USE_FAKE_STORAGE_PROVIDER=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Background Worker & Sync
SYNC_INTERVAL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=10737418240 # 10 GB
UPLOAD_CHUNK_SIZE_BYTES=5242880   # 5 MB

# AWS Production Deployment (leave empty for local development)
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
AWS_SECRETS_MANAGER_SECRET_NAME=
